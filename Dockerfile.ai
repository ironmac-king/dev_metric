# Python AI 服务 Dockerfile
FROM python:3.12-slim

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制源码
COPY ai/ ai/
COPY config.yaml .

# 本地模型文件
COPY ai/ml/models/ ai/ml/models/

EXPOSE 18081

ENV USE_SEMANTIC_LAYER=1
CMD ["python", "-m", "uvicorn", "ai.main:app", "--host", "0.0.0.0", "--port", "18081"]
