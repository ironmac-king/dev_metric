import requests
import json
r = requests.post('http://localhost:8081/api/v1/ask', json={
    'question': '上月增长最快的是哪个店铺',
    'session_id': 'test-fix3'
}, timeout=60)
d = r.json()
with open('suggest_output.json', 'w', encoding='utf-8') as f:
    json.dump({
        'suggest': d.get('suggest', []),
        'intent': d.get('thinking_steps', [{}])[0].get('content', 'N/A') if d.get('thinking_steps') else 'N/A'
    }, f, ensure_ascii=False, indent=2)
